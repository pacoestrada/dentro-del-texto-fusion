{ Tools = ordered() { PacoDentroDelTexto = MacroOperator { Inputs = ordered() { MainInput1 = InstanceInput { SourceOp = "Clip", Source = "Input" },
Input1 = InstanceInput { SourceOp = "TextWindow", Source = "StyledText", Name = "Texto",  },
Input2 = InstanceInput { SourceOp = "TextWindow", Source = "Font", Name = "Fuente", ControlGroup = 2, },
Input3 = InstanceInput { SourceOp = "TextWindow", Source = "Style", Name = "Estilo", ControlGroup = 2, },
Input4 = InstanceInput { SourceOp = "Controls", Source = "NumberIn1", Name = "Tamano inicial", Default = 0.18, MinScale = 0, MaxScale = 0.5, },
Input5 = InstanceInput { SourceOp = "Controls", Source = "NumberIn2", Name = "Espera (fotogramas)", Default = 25, MinScale = 0, MaxScale = 150, },
Input6 = InstanceInput { SourceOp = "Controls", Source = "NumberIn3", Name = "Zoom (fotogramas)", Default = 75, MinScale = 0, MaxScale = 250, },
Input7 = InstanceInput { SourceOp = "Controls", Source = "NumberIn4", Name = "Ampliacion final", Default = 60, MinScale = 0, MaxScale = 150, },
Input8 = InstanceInput { SourceOp = "Controls", Source = "NumberIn5", Name = "Entrada X", Default = 0.5, MinScale = 0, MaxScale = 1, },
Input9 = InstanceInput { SourceOp = "Controls", Source = "NumberIn6", Name = "Entrada Y", Default = 0.5, MinScale = 0, MaxScale = 1, } }, Outputs = { MainOutput1 = InstanceOutput { SourceOp = "Reveal", Source = "Output" } }, Tools = ordered() { Clip = BrightnessContrast { Inputs = { Gain = Input { Value = 1 } } },
Controls = Custom { Inputs = { NumberIn1 = Input { Value = 0.18 }, NumberIn2 = Input { Value = 25 }, NumberIn3 = Input { Value = 75 }, NumberIn4 = Input { Value = 60 }, NumberIn5 = Input { Value = 0.5 }, NumberIn6 = Input { Value = 0.5 }, NumberIn7 = Input { Expression = "min(1,max(0,(time-comp.RenderStart-Controls.NumberIn2)/max(1,Controls.NumberIn3)))" }, NumberIn8 = Input { Expression = "max(1,Controls.NumberIn4)^(Controls.NumberIn7*Controls.NumberIn7*(3-2*Controls.NumberIn7))" } } },
TextWindow = TextPlus { Inputs = { Width = Input { Value = 1920 }, Height = Input { Value = 1080 }, UseFrameFormatSettings = Input { Value = 1 }, StyledText = Input { Value = "ENTRA" }, Font = Input { Value = "DejaVu Sans" }, Style = Input { Value = "Bold" }, Size = Input { Expression = "max(0.001,Controls.NumberIn1)*Controls.NumberIn8" }, Center = Input { Expression = "Point(0.5+(0.5-Controls.NumberIn5)*(Controls.NumberIn8-1),0.5+(0.5-Controls.NumberIn6)*(Controls.NumberIn8-1))" }, VerticalJustificationNew = Input { Value = 3 }, HorizontalJustificationNew = Input { Value = 3 } } },
Black = Background { Inputs = { Width = Input { Value = 1920 }, Height = Input { Value = 1080 }, UseFrameFormatSettings = Input { Value = 1 }, TopLeftRed = Input { Value = 0 }, TopLeftGreen = Input { Value = 0 }, TopLeftBlue = Input { Value = 0 }, TopLeftAlpha = Input { Value = 1 } } },
Window = Merge { Inputs = { Background = Input { SourceOp = "Black", Source = "Output" }, Foreground = Input { SourceOp = "Clip", Source = "Output" }, EffectMask = Input { SourceOp = "TextWindow", Source = "Output" }, PerformDepthMerge = Input { Value = 0 } } },
Reveal = Dissolve { Transitions = { [0] = "DFTDissolve" }, Inputs = { Background = Input { SourceOp = "Window", Source = "Output" }, Foreground = Input { SourceOp = "Clip", Source = "Output" }, Mix = Input { Expression = "min(1,max(0,(Controls.NumberIn7-0.85)/0.15))" } } } } } }, ActiveTool = "PacoDentroDelTexto" }